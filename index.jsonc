{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "@rljson/converter",

  // 1-2 sentence summary about this repo.
  "summary": "Converts tree-like JSON into Rljson by a DecomposeChart: sliceIds, components, layers, cake, edit and insert history tables with tableCfgs. API: fromJson, DecomposeChart, findSliceIdCollisions.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "JSON object or array -> Rljson tables",
    "DecomposeChart: components, aliases, references, sub-types (_types), nested/composite/fallback _sliceId",
    "sliceId collisions (warning, findSliceIdCollisions), progress callback"
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "rljson": "table types, createXTableCfg helpers, removeDuplicates",
      "hash": "hip/hsh: tables, composite and fallback sliceIds",
      "json": "Json types"
    },

    // "<repo-b>": "why / API"
    "usedBy": {
      "db": "test: mass data (fromJson, DecomposeChart)"
    }
  }
}
