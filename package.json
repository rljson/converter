{
  "name": "@rljson/converter",
  "version": "0.0.59",
  "description": "Convert flat textual data i. e. from JSON or XML into RLJSON data structure and data itself automatically.",
  "homepage": "https://github.com/rljson/converter",
  "bugs": "https://github.com/rljson/converter/issues",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rljson/converter.git"
  },
  "main": "dist/converter.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm exec vite build && tsc && node scripts/copy-readme-to-dist.js",
    "test": "pnpm exec vitest run --coverage && pnpm run lint",
    "prebuild": "npm run test",
    "prepublishOnly": "npm run build",
    "lint": "pnpm exec eslint",
    "updateGoldens": "cross-env UPDATE_GOLDENS=true pnpm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^5.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-tsdoc": "^0.5.3",
    "globals": "^17.12.0",
    "jsdoc": "^4.0.5",
    "read-pkg": "^10.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-node": "^6.0.0",
    "vite-plugin-dts": "^5.1.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1",
    "vitest-dom": "^0.1.1"
  },
  "dependencies": {
    "@rljson/hash": "0.0.19",
    "@rljson/json": "0.0.23",
    "@rljson/rljson": "0.0.81",
    "object-traversal": "^1.0.1"
  },
  "packageManager": "pnpm@10.11.0"
}
